    "format:check": "prettier --check ."
  },
  "dependencies": {
    "i18next": "^25.6.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.9.4",
    "react-scroll": "^1.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-scroll": "^1.8.10",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "sass-embedded": "^1.93.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
